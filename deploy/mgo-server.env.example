# /etc/mgo-server.env — systemd EnvironmentFile (see deploy/mgo-server.service)
# systemd format: KEY=VALUE per line, no quotes, no `export`, no inline comments.
# Full list of keys and their defaults: ../.env.example

MGO_HOST=0.0.0.0
MGO_PORT=8080

# Client IPs allowed to reach the service (127.0.0.1/::1 are always allowed).
# Runtime changes made from localhost land in <workspace>/whitelist.json and are
# merged with this list at every start.
MGO_IP_WHITELIST=220.165.246.72

# Where the MGO C++ binary lives on this host.
MGO_BINARY=/opt/MGO/build/bin/MGOConsole

# Keep 'loopback' unless the service is behind a reverse proxy on another host;
# then use a hop count or subnet list. 'true' is not a valid value: it lets any
# remote client forge X-Forwarded-For and bypass the whitelist.
MGO_TRUST_PROXY=loopback

MGO_WORKSPACE=/opt/MGOServer/workspace
MGO_LOG_LEVEL=info
