# deps
node_modules/

# runtime state: jobs, uploads, artifacts, and the persisted IP whitelist
# (workspace/whitelist.json is per-deployment config, deliberately not source)
workspace/

# self-hosted Cesium, regenerated with `npm run sync:cesium`
public/cesium/

# local deployment config (see .env.example)
.env
.env.local

# test / tooling output — the checked-in fixtures under test/fixtures/ stay tracked
test-results/
playwright-report/
ui-test-results/
*.log
!test/fixtures/*.log

# editors / OS
.DS_Store
.idea/
.vscode/
test/**/*.obj
test/**/*.tif
test/**/*.zip
test/**/*.log

# engine binaries are downloaded by scripts/setup.mjs (npm postinstall) from the
# pre-configured addresses in package.json mgoEngine.downloads — never committed;
# offline installs use MGO_ENGINE_BUNDLE (see build/bin/README.md)
build/

# engine bundle output (scripts/pack-engine.mjs → upload to GitHub Releases)
dist/
