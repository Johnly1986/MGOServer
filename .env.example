# MGOServer deployment config
#
#   cp .env.example .env   then edit   — loaded automatically by src/config.js on
#   every start (npm start, `node src/server.js`, systemd), no dotenv dependency.
#   Real environment variables (shell export, systemd Environment=/EnvironmentFile=,
#   container env) always win over this file. MGO_ENV_FILE points at another path.
#   One KEY=VALUE per line; `#` starts a whole-line comment (no inline comments).

# --- listen ---
# 0.0.0.0 = reachable from other machines (requires the IP whitelist below).
# 127.0.0.1 = local only.
MGO_HOST=0.0.0.0
MGO_PORT=8080

# --- the MGO C++ toolkit this service shells out to ---
# Default search: ./build/bin/linux/ or ./build/bin/windows/ (downloaded here by
# the npm postinstall installer; older flat ./build/bin/ still works), then
# ../MGO/build/bin/** (sibling checkout), then `mgo` on PATH. Point at the real
# binary if your layout differs, e.g.
#MGO_BINARY=/opt/MGO/build/bin/MGOConsole

# --- engine installer (scripts/setup.mjs, run automatically by npm postinstall) ---
# Client machines never build: the installer fetches a prebuilt SELF-CONTAINED
# engine bundle (MGOConsole + all GIS runtime libs + proj.db + gdal-data) from
# the pre-configured addresses in package.json "mgoEngine.downloads", verifies
# sha256, unpacks into build/bin/<platform>/ and probes it. Overrides:
#MGO_ENGINE_URL=              # explicit bundle download address (wins over manifest)
#MGO_ENGINE_MIRROR=           # mirror for manifest URLs: '{url}' template or base prefix
#MGO_ENGINE_BUNDLE=           # offline install from a local .tgz/.zip (beats any remote)
#MGO_ENGINE_SKIP=1            # don't touch the engine at all
#MGO_ENGINE_TIMEOUT_MS=1800000

# --- workspace (jobs / uploads / artifacts / whitelist.json) ---
#MGO_WORKSPACE=workspace
#MGO_TTL_DAYS=7
#MGO_MIN_FREE_GB=10

# --- limits ---
# 2 GiB per uploaded file
#MGO_UPLOAD_MAX_BYTES=2147483648
# per-job file cap (osgb folder uploads)
#MGO_UPLOAD_MAX_FILES=5000
# tiles multi-file conversion cap (inputs per job, merged via 3d-tiles-tools)
#MGO_MAX_INPUT_FILES=32
# 3d-tiles-tools CLI used to merge multi-file tiles outputs into one unified
# tileset.json. Default: node_modules/3d-tiles-tools/build/src/cli.mjs (npm
# dependency, run with the service's own node). May also point at any
# executable wrapper.
#MGO_3D_TILES_TOOLS=
# terrain already parallelizes inside mgo, don't raise this lightly
#MGO_MAX_CONCURRENT_JOBS=1
#MGO_QUEUE_MAX=100
#MGO_JOB_TIMEOUT_S=14400

# --- access control (REQUIRED before exposing beyond localhost) ---
# Comma-separated exact IPs and/or CIDR blocks. 127.0.0.1/::1 are always allowed
# and cannot be removed. Runtime edits via the localhost-only
# GET/POST /api/v1/whitelist land in <workspace>/whitelist.json and survive restarts.
#MGO_IP_WHITELIST=220.165.246.72,10.0.0.0/8
#MGO_CORS_ORIGIN=*
# Which peers may set X-Forwarded-For: "loopback" (default; reverse proxy on this
# machine), a hop count, or a proxy-addr subnet list. Never "true" — that lets any
# remote client forge X-Forwarded-For: 127.0.0.1 and bypass the whitelist entirely.
#MGO_TRUST_PROXY=loopback

# --- server-local input paths (skip uploads; keep off unless needed) ---
#MGO_ALLOW_LOCAL_PATH=1
# ':' separated on POSIX, ';' on Windows
#MGO_ALLOWED_ROOTS=/data/incoming:/data/prj
# Local inputs are processed IN PLACE — the server never moves or copies them.
# For tiles/mesh, inputPath may also be a model+textures FOLDER (assimp resolves
# side-car textures relative to the model dir); tiles auto-takes EVERY model in
# the folder (modelPath(s) can narrow it), mesh needs modelPath(s) to resolve
# multi-candidate ambiguity. MGO_MAX_INPUT_FILES caps model count,
# MGO_UPLOAD_MAX_FILES bounds the folder scan. Also unlocks the console's
# "server path" mode with a read-only directory browser (POST /api/v1/fs/browse,
# whitelisted IPs only).

# --- logging ---
#MGO_LOG_LEVEL=info
