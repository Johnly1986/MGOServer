# MGOServer deployment config
#
#   cp .env.example .env   then edit   — loaded automatically by src/config.js on
#   every start (npm start, `node src/server.js`, systemd), no dotenv dependency.
#   Real environment variables (shell export, systemd Environment=/EnvironmentFile=,
#   container env) always win over this file. MGO_ENV_FILE points at another path.
#   One KEY=VALUE per line; `#` starts a whole-line comment (no inline comments).

# --- listen ---
# 0.0.0.0 = reachable from other machines (requires the IP whitelist below).
# 127.0.0.1 = local only.
MGO_HOST=0.0.0.0
MGO_PORT=8080

# --- the MGO C++ toolkit this service shells out to ---
# Default search: ./build/bin/MGOConsole (bundled with this repo), then
# ../MGO/build/bin/** (sibling checkout), then `mgo` on PATH. Point at the real
# binary if your layout differs, e.g.
#MGO_BINARY=/opt/MGO/build/bin/MGOConsole

# --- workspace (jobs / uploads / artifacts / whitelist.json) ---
#MGO_WORKSPACE=workspace
#MGO_TTL_DAYS=7
#MGO_MIN_FREE_GB=10

# --- limits ---
# 2 GiB per uploaded file
#MGO_UPLOAD_MAX_BYTES=2147483648
# per-job file cap (osgb folder uploads)
#MGO_UPLOAD_MAX_FILES=5000
# terrain already parallelizes inside mgo, don't raise this lightly
#MGO_MAX_CONCURRENT_JOBS=1
#MGO_QUEUE_MAX=100
#MGO_JOB_TIMEOUT_S=14400

# --- access control (REQUIRED before exposing beyond localhost) ---
# Comma-separated exact IPs and/or CIDR blocks. 127.0.0.1/::1 are always allowed
# and cannot be removed. Runtime edits via the localhost-only
# GET/POST /api/v1/whitelist land in <workspace>/whitelist.json and survive restarts.
#MGO_IP_WHITELIST=220.165.246.72,10.0.0.0/8
#MGO_CORS_ORIGIN=*
# Which peers may set X-Forwarded-For: "loopback" (default; reverse proxy on this
# machine), a hop count, or a proxy-addr subnet list. Never "true" — that lets any
# remote client forge X-Forwarded-For: 127.0.0.1 and bypass the whitelist entirely.
#MGO_TRUST_PROXY=loopback

# --- server-local input paths (skip uploads; keep off unless needed) ---
#MGO_ALLOW_LOCAL_PATH=1
# ':' separated on POSIX, ';' on Windows
#MGO_ALLOWED_ROOTS=/data/incoming:/data/prj

# --- logging ---
#MGO_LOG_LEVEL=info
